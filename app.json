{
  "expo": {
    "name": "True Strength",
    "slug": "true-strength",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "truestrength",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "uk.co.truestrengthandfitness.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Only admin/staff accounts require camera access. This allows staff to scan QR codes for physical gym entry.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.truestrength.app",
      "versionCode": 2,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "@stripe/stripe-react-native",
        {}
      ],
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Only admin/staff accounts require camera access. This allows staff to scan QR codes for physical gym entry."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8a23d9b8-25df-4924-96ea-02b816f77539"
      }
    },
    "owner": "galvinatorj",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8a23d9b8-25df-4924-96ea-02b816f77539"
    }
  }
}
